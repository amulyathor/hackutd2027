# NVIDIA NIM / build.nvidia.com API Key (supports nvidia/nvidia-nemotron-nano-9b-v2 or llama-3.1-nemotron-70b-instruct)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# Optional: OpenRouter API Key if calling Nemotron via OpenRouter
OPENROUTER_API_KEY=

